{
  "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.csr.html",
  "navigationUrls": ["/app", "/app/**"],
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/index.csr.html", "/*.js", "/*.css", "/media/**"]
      }
    },
    {
      "name": "app-static",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/icons/**", "/manifest.webmanifest"]
      }
    }
  ]
}
