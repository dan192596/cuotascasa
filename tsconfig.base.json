{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "@cuotascasa/domain": ["./packages/domain/src/index.ts"],
      "@cuotascasa/schema": ["./packages/schema/src/index.ts"],
      "@cuotascasa/schema/testing": ["./packages/schema/src/testing/index.ts"],
      "@cuotascasa/persistence": ["./packages/persistence/src/ports.ts"],
      "@cuotascasa/persistence/memory": ["./packages/persistence/src/memory/index.ts"],
      "@cuotascasa/persistence/dexie": ["./packages/persistence/src/dexie/index.ts"],
      "@cuotascasa/persistence/contract": ["./packages/persistence/src/contract/index.ts"],
      "@cuotascasa/sync": ["./packages/sync/src/ports.ts"],
      "@cuotascasa/sync/crypto": ["./packages/sync/src/crypto/index.ts"],
      "@cuotascasa/sync/session": ["./packages/sync/src/session/index.ts"],
      "@cuotascasa/sync/google-drive": ["./packages/sync/src/google-drive/index.ts"],
      "@cuotascasa/sync/testing": ["./packages/sync/src/testing/index.ts"],
      "@cuotascasa/export": ["./packages/export/src/index.ts"],
      "@cuotascasa/export/model": ["./packages/export/src/model/index.ts"],
      "@cuotascasa/export/csv": ["./packages/export/src/csv/index.ts"],
      "@cuotascasa/export/excel": ["./packages/export/src/excel/index.ts"],
      "@cuotascasa/export/pdf": ["./packages/export/src/pdf/index.ts"]
    }
  }
}
